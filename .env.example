# Copy to .env and set real values. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The database passwords must match the users created in
# infrastructure/mysql/init/01-schema.sql. If you change them here, change them
# there too and recreate the volume:
#
#   docker-compose down -v && docker-compose up -d

# Grafana login
ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

# MySQL
MYSQL_ROOT_PASSWORD=changeme

ORDER_DB_NAME=orderdb
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=changeme

INVENTORY_DB_NAME=inventorydb
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=changeme
